# ── Local development (SQLite file) ──
DATABASE_URL="file:./prisma/dev.db"

# ── Production on Vercel (Turso / libSQL) ──
# DATABASE_URL="libsql://YOUR-DB.turso.io?authToken=YOUR_TOKEN"

# NextAuth — در production حتماً AUTH_SECRET قوی بگذارید
AUTH_SECRET="change-me-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AWS S3 (توصیه‌شده برای production — آپلود محصول و رسید)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="shooka-candle-images"

# SMTP (برای بازیابی رمز عبور)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@shooka-candle.ir"
